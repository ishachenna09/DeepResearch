# ─────────────── App ───────────────
APP_ENV=local
APP_NAME=DeepResearch
FRONTEND_URL=http://localhost:5173

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=PASTE_A_64_CHAR_RANDOM_STRING_HERE

# ─────────────── Auth ───────────────
ACCESS_TOKEN_EXPIRE_MIN=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# Phase 9: open locally; "invite" requires X-Invite-Code on POST /auth/register.
REGISTRATION_MODE=open
REGISTRATION_INVITE_CODE=

# ─────────────── Phase 9: abuse controls ───────────────
# Host header allowlist (comma-separated). Behind Caddy this is the public
# domain; a wrong Host is rejected before any route runs.
ALLOWED_HOSTS=localhost,127.0.0.1,::1,testserver
# Tests and the load baseline turn limits off / raise the budget instead of
# editing decorators. Keep both at their defaults in production.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MULTIPLIER=1.0
# Only true behind a proxy that OVERWRITES X-Forwarded-For (Phase 10: Caddy).
# Trusting it locally lets a caller choose their own rate-limit bucket.
TRUST_PROXY_HEADERS=false

# ─────────────── Neon (Postgres + pgvector) ───────────────
# Neon console → your project → Connection Details → use the POOLED uri
# Format: postgresql+asyncpg://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?ssl=require
# Named APP_DATABASE_URL on purpose — LiteLLM auto-adopts any env var named
# DATABASE_URL as ITS OWN metadata DB and crashes on the +asyncpg scheme.
# Format: postgresql+asyncpg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?ssl=require
APP_DATABASE_URL=

# ─────────────── Upstash (Redis) ───────────────
# Upstash console → your DB → REST & TCP → copy the rediss:// TLS URL
REDIS_URL=

# ─────────────── LiteLLM proxy ───────────────
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-local-dev
LLM_PRIMARY_MODEL=support-chat

# Phase 3 embeddings. EMBED_DIM is a CONTRACT with the DB column
# (source_notes.embedding vector(1536)): changing it requires a new migration
# plus a re-embed, otherwise inserts fail on a dimension mismatch.
EMBEDDINGS_MODEL=embeddings
EMBED_DIM=1536

# ─────────────── LLM providers (free tiers) ───────────────
GEMINI_API_KEY=
GROQ_API_KEY=

# ─────────────── Langfuse Cloud (observability) ───────────────
# langfuse.com → Project Settings → API Keys
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# -----------------------------------------------
# Phase 6: agents as A2A services
# local = writer + critic run in-process (default; one uvicorn is enough)
# a2a   = call the two agent services over JSON-RPC (deploy sets this)
AGENTS_MODE=local
A2A_WRITER_URL=http://127.0.0.1:8010
A2A_CRITIC_URL=http://127.0.0.1:8011
# Shared secret for both agent services. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty on the agent side = it returns 503 instead of running open.
A2A_TOKEN=
A2A_READ_TIMEOUT=200
