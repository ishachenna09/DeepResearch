# ─────────────── App ───────────────
APP_ENV=local
APP_NAME=DeepResearch
FRONTEND_URL=http://localhost:5173

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=PASTE_A_64_CHAR_RANDOM_STRING_HERE

# ─────────────── Auth ───────────────
ACCESS_TOKEN_EXPIRE_MIN=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# ─────────────── Neon (Postgres + pgvector) ───────────────
# Neon console → your project → Connection Details → use the POOLED uri
# Format: postgresql+asyncpg://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?ssl=require
# Named APP_DATABASE_URL on purpose — LiteLLM auto-adopts any env var named
# DATABASE_URL as ITS OWN metadata DB and crashes on the +asyncpg scheme.
# Format: postgresql+asyncpg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?ssl=require
APP_DATABASE_URL=

# ─────────────── Upstash (Redis) ───────────────
# Upstash console → your DB → REST & TCP → copy the rediss:// TLS URL
REDIS_URL=

# ─────────────── LiteLLM proxy ───────────────
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-local-dev
LLM_PRIMARY_MODEL=support-chat

# ─────────────── LLM providers (free tiers) ───────────────
GEMINI_API_KEY=
GROQ_API_KEY=

# ─────────────── Langfuse Cloud (observability) ───────────────
# langfuse.com → Project Settings → API Keys
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
